<%- include('../partials/header') %>

<div class="wrapper">
  <%- include('../partials/sidebar') %>

  <div class="page-right">
    <%- include('../partials/navbar') %>

    <div class="main-content">
      <div class="container-fluid">

      <!-- Page Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h2 class="fw-bold text-dark mb-1">Enter Marks</h2>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
              <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
              <li class="breadcrumb-item active" aria-current="page">Enter Marks</li>
            </ol>
          </nav>
        </div>
      </div>

      <!-- Alerts -->
      <% if (error) { %>
        <div class="alert alert-danger border-0 shadow-sm mb-4" role="alert">
          <i class="fa-solid fa-circle-exclamation me-2"></i><%= error %>
        </div>
      <% } %>
      <% if (success) { %>
        <div class="alert alert-success border-0 shadow-sm mb-4" role="alert">
          <i class="fa-solid fa-circle-check me-2"></i><%= success %>
        </div>
      <% } %>

      <!-- Criteria Selectors -->
      <div class="card border-0 shadow-sm bg-white p-4 mb-4">
        <form action="/teacher/marks" method="GET" class="row g-3 align-items-end">
          <input type="hidden" name="classId" value="<%= selectedClassId %>">
          <div class="col-md-3">
            <label class="form-label text-secondary fw-semibold">Selected Class</label>
            <div class="d-flex align-items-center justify-content-between border rounded p-2 bg-light">
              <span class="fw-bold text-dark"><%= selectedClass ? selectedClass.name : 'Class' %></span>
              <a href="/teacher/select-class" class="btn btn-sm btn-outline-warning text-dark fw-bold px-2 py-0" style="font-size:12px;">Switch</a>
            </div>
          </div>
          <div class="col-md-3">
            <label class="form-label text-secondary fw-semibold">Subject Name</label>
            <input type="text" name="subjectName" class="form-control" placeholder="E.g. Quran, Arabic" value="<%= subjectName %>" required>
          </div>
          <div class="col-md-2">
            <label class="form-label text-secondary fw-semibold">Exam Type</label>
            <select name="examType" class="form-select" required>
              <option value="Midterm" <%= examType === 'Midterm' ? 'selected' : '' %>>Midterm</option>
              <option value="Final" <%= examType === 'Final' ? 'selected' : '' %>>Final</option>
              <option value="Monthly Test" <%= examType === 'Monthly Test' ? 'selected' : '' %>>Monthly Test</option>
              <option value="Weekly Quiz" <%= examType === 'Weekly Quiz' ? 'selected' : '' %>>Weekly Quiz</option>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label text-secondary fw-semibold">Exam Date</label>
            <input type="date" name="examDate" class="form-control" value="<%= examDate %>" required>
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-dark w-100 py-2">
              <i class="fa-solid fa-file-invoice me-2"></i>Load Sheet
            </button>
          </div>
        </form>
      </div>

      <!-- Marks Sheet Table -->
      <% if (selectedClassId) { %>
        <div class="card border-0 shadow-sm bg-white p-4">
          <h5 class="fw-bold mb-4 text-dark"><i class="fa-solid fa-circle-info text-warning me-2"></i>Entering Marks for Subject: <span class="text-primary"><%= subjectName %></span> | Exam: <span class="text-primary"><%= examType %></span></h5>
          
          <% if (students.length === 0) { %>
            <div class="text-muted text-center py-5">
              <i class="fa-solid fa-users-slash fa-2x mb-3 text-light"></i>
              <p class="mb-0">No students found assigned to this class.</p>
            </div>
          <% } else { %>
            <form action="/teacher/marks" method="POST">
              <input type="hidden" name="classId" value="<%= selectedClassId %>">
              <input type="hidden" name="subjectName" value="<%= subjectName %>">
              <input type="hidden" name="examType" value="<%= examType %>">
              <input type="hidden" name="examDate" value="<%= examDate %>">

              <div class="table-responsive mb-4">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th style="width: 30%;">Student Name</th>
                      <th style="width: 20%;">Adm. No</th>
                      <th style="width: 25%;">Marks Obtained</th>
                      <th style="width: 25%;">Max Marks</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% students.forEach(student => { %>
                      <% 
                        const existingMark = marksMap[student.id] ? marksMap[student.id].marksObtained : '';
                        const existingMax = marksMap[student.id] ? marksMap[student.id].maxMarks : 100;
                      %>
                      <tr>
                        <td><span class="fw-bold text-dark"><%= student.name %></span></td>
                        <td><span class="badge bg-light text-dark fw-semibold"><%= student.admissionNumber %></span></td>
                        <td>
                          <input type="number" step="0.5" min="0" max="200" name="marks[s_<%= student.id %>][marksObtained]" class="form-control form-control-sm width-150" placeholder="Enter Score" value="<%= existingMark %>" required>
                        </td>
                        <td>
                          <input type="number" min="1" max="200" name="marks[s_<%= student.id %>][maxMarks]" class="form-control form-control-sm width-150" placeholder="Default 100" value="<%= existingMax %>" required>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>

              <div class="text-end">
                <button type="submit" class="btn btn-success px-5 py-3 fw-bold shadow hover-lift">
                  <i class="fa-solid fa-save me-2"></i>Save Grades
                </button>
              </div>
            </form>
          <% } %>
        </div>
      <% } else { %>
        <div class="card border-0 shadow-sm bg-white p-5 text-center">
          <i class="fa-solid fa-clipboard-question fa-4x text-light mb-3"></i>
          <h5 class="fw-semibold text-secondary">Please select class filters and click "Load Sheet" to enter marks.</h5>
        </div>
      <% } %>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
