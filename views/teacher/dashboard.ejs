<%- include('../partials/header') %>

<div class="wrapper">
  <%- include('../partials/sidebar') %>

  <div class="page-right">
    <%- include('../partials/navbar') %>

    <div class="main-content">
      <div class="container-fluid">

      <!-- Page Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h2 class="fw-bold text-dark mb-1">Teacher Dashboard</h2>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
              <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
              <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
            </ol>
          </nav>
        </div>
        <div class="text-secondary small">
          <i class="fa-regular fa-calendar-days me-1"></i>
          Today: <%= new Date().toLocaleDateString(undefined, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
        </div>
      </div>

      <!-- Welcome Card -->
      <div class="card border-0 bg-dark text-white p-4 mb-4 shadow-sm" style="border-radius: 16px;">
        <div class="row align-items-center">
          <div class="col-md-8">
            <h4 class="fw-bold mb-2 text-warning"><i class="fa-solid fa-chalkboard-user me-2"></i>Welcome, <%= teacher.name %>!</h4>
            <p class="mb-0 text-white-50">
              Department: <strong><%= teacher.subject || 'General' %></strong> | Select your class below to begin.
            </p>
          </div>
        </div>
      </div>

      <!-- Prominent Class Selector Hub (Request: teacher login cheythitt oru class select option) -->
      <div class="card border-0 shadow-sm p-4 mb-4 bg-white rounded-4">
        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
          <h5 class="fw-bold text-dark m-0">
            <i class="fa-solid fa-school text-primary me-2"></i>Select Your Class
          </h5>
          <span class="badge bg-primary rounded-pill"><%= classes.length %> Available Classes</span>
        </div>
        <p class="text-muted small mb-4">Choose a class to mark attendance, record marks, or review tasks:</p>

        <div class="row g-3">
          <% classes.forEach(c => { %>
            <div class="col-md-6 col-lg-4">
              <div class="card border border-2 border-light shadow-xs rounded-4 p-3 hover-lift bg-light h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                  <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary text-white rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                      <i class="fa-solid fa-graduation-cap fs-5"></i>
                    </div>
                    <div>
                      <h6 class="fw-bold m-0 text-dark fs-5"><%= c.name %></h6>
                      <span class="small text-muted">Class Level <%= c.level || c.id %></span>
                    </div>
                  </div>
                </div>

                <div class="d-grid gap-2">
                  <a href="/teacher/attendance?classId=<%= c.id %>" class="btn btn-warning btn-sm fw-bold text-dark py-2">
                    <i class="fa-solid fa-calendar-check me-2"></i>Mark Attendance
                  </a>
                  <div class="d-flex gap-2">
                    <a href="/teacher/tasks?classId=<%= c.id %>" class="btn btn-outline-primary btn-sm w-50 fw-semibold">
                      <i class="fa-solid fa-list-check me-1"></i>Tasks
                    </a>
                    <a href="/teacher/marks?classId=<%= c.id %>" class="btn btn-outline-success btn-sm w-50 fw-semibold">
                      <i class="fa-solid fa-file-signature me-1"></i>Marks
                    </a>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Stats Cards -->
      <div class="row g-4 mb-4">
        <div class="col-md-6">
          <div class="card card-hover border-0 shadow-sm bg-white p-4 h-100">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <h6 class="text-muted mb-1 text-uppercase fw-bold small">My Assigned Classes</h6>
                <h2 class="fw-bold mb-0 text-dark"><%= stats.classCount %></h2>
              </div>
              <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                <i class="fa-solid fa-school fa-2x"></i>
              </div>
            </div>
          </div>
        </div>
        
        <div class="col-md-6">
          <div class="card card-hover border-0 shadow-sm bg-white p-4 h-100">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <h6 class="text-muted mb-1 text-uppercase fw-bold small">Students in My Classes</h6>
                <h2 class="fw-bold mb-0 text-dark"><%= stats.studentCount %></h2>
              </div>
              <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                <i class="fa-solid fa-graduation-cap fa-2x"></i>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Assigned Classes List & Actions -->
      <div class="row g-4 mb-4">
        <!-- Classes Taught -->
        <div class="col-lg-7">
          <div class="card border-0 shadow-sm bg-white p-4 h-100">
            <h5 class="fw-bold mb-4 text-dark"><i class="fa-solid fa-chalkboard text-primary me-2"></i>My Classes</h5>
            
            <% if (classes.length === 0) { %>
              <div class="alert alert-info border-0 shadow-sm">
                No classes currently assigned to you. Contact the Admin to get assigned to a class.
              </div>
            <% } else { %>
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Class Name</th>
                      <th>Room</th>
                      <th class="text-end">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% classes.forEach(c => { %>
                      <tr>
                        <td>
                          <span class="fw-bold"><%= c.name %></span>
                        </td>
                        <td>
                          <span class="badge bg-light text-dark"><%= c.roomNumber || 'N/A' %></span>
                        </td>
                        <td class="text-end">
                          <a href="/teacher/attendance?classId=<%= c.id %>" class="btn btn-sm btn-outline-success me-2 rounded-pill">
                            <i class="fa-solid fa-calendar-check me-1"></i> Attendance
                          </a>
                          <a href="/teacher/marks?classId=<%= c.id %>" class="btn btn-sm btn-outline-primary rounded-pill">
                            <i class="fa-solid fa-file-signature me-1"></i> Marks
                          </a>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Recent Marks Entries Feed -->
        <div class="col-lg-5">
          <div class="card border-0 shadow-sm bg-white p-4 h-100">
            <h5 class="fw-bold mb-4 text-dark"><i class="fa-solid fa-history me-2" style="color:var(--indigo);"></i>Recent Grade Submissions</h5>
            
            <% if (recentMarks.length === 0) { %>
              <div class="text-muted text-center py-4">
                <i class="fa-regular fa-clipboard fa-3x mb-3 text-light"></i>
                <p class="mb-0">No grades submitted recently.</p>
              </div>
            <% } else { %>
              <div class="list-group list-group-flush">
                <% recentMarks.forEach(m => { %>
                  <div class="list-group-item px-0 py-3 border-bottom">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <h6 class="fw-bold mb-0 text-dark"><%= m.student ? m.student.name : 'Unknown Student' %></h6>
                      <span class="badge px-2 py-1 small" style="background:var(--indigo-light);color:var(--indigo-dark);">
                        <%= m.marksObtained %> / <%= m.maxMarks %>
                      </span>
                    </div>
                    <div class="d-flex justify-content-between text-secondary small">
                      <span>Subject: <%= m.subjectName %> (<%= m.examType %>)</span>
                      <span><%= new Date(m.examDate).toLocaleDateString() %></span>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
