<%- include('../partials/header') %>

<style>
  /* Mobile App-like Violet Theme Styles for Take Attendance */
  body {
    background-color: #faf8fd !important;
  }
  
  .app-bar-violet {
    background: linear-gradient(135deg, #7c3aed, #5b21b6);
    color: white;
    border-radius: 18px;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 4px 15px rgba(124, 58, 237, 0.15);
    margin-bottom: 20px;
  }

  .app-bar-title {
    font-size: 22px;
    font-weight: 700;
    margin: 0;
    color: white;
  }

  .app-bar-sub {
    font-size: 13px;
    opacity: 0.85;
    margin-top: 4px;
    font-weight: 500;
  }

  .date-card {
    background: #f5f3ff;
    border-radius: 16px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    border: 1.5px solid #ddd6fe;
  }

  .date-btn {
    background: white;
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #7c3aed;
    box-shadow: 0 2px 4px rgba(109, 40, 217, 0.05);
    cursor: pointer;
    transition: transform 0.1s;
  }

  .date-btn:active {
    transform: scale(0.95);
  }

  .date-display {
    text-align: center;
  }

  .date-main {
    font-size: 16px;
    font-weight: 700;
    color: #1f2937;
  }

  .date-sub {
    font-size: 11px;
    color: #7c3aed;
    margin-top: 2px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
  }

  .student-card {
    background: white;
    border-radius: 16px;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    box-shadow: 0 4px 6px -1px rgba(109, 40, 217, 0.02), 0 2px 4px -1px rgba(109, 40, 217, 0.01);
    border: 1px solid #eef2f6;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .student-card:active {
    transform: scale(0.98);
  }

  .student-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .roll-badge {
    background: linear-gradient(135deg, #8b5cf6, #6d28d9);
    color: white;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 16px;
    box-shadow: 0 4px 10px rgba(109, 40, 217, 0.2);
  }

  .student-info {
    display: flex;
    flex-direction: column;
  }

  .student-name {
    font-size: 16px;
    font-weight: 700;
    color: #1f2937;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .student-roll {
    font-size: 12px;
    color: #9ca3af;
    margin-top: 2px;
    font-weight: 500;
  }

  .mark-action-area {
    display: flex;
    align-items: center;
  }

  .tick-icon-present {
    color: #10b981;
    font-size: 34px;
    cursor: pointer;
  }

  .tick-icon-absent {
    color: #d1d5db;
    font-size: 34px;
    opacity: 0.6;
    cursor: pointer;
  }

  .attendance-trigger-btn {
    cursor: pointer;
    user-select: none;
  }
</style>

<div class="wrapper">
  <%- include('../partials/sidebar') %>

  <div class="page-right">
    <%- include('../partials/navbar') %>

    <div class="main-content">
      <div class="container-fluid" style="max-width: 540px; margin: 0 auto; padding: 0;">

        <!-- Success/Error Alerts -->
        <% if (success) { %>
          <div class="flash-success mx-3 my-2">
            <i class="fa-solid fa-circle-check"></i>
            <div><%= success %></div>
          </div>
        <% } %>
        <% if (error) { %>
          <div class="flash-error mx-3 my-2">
            <i class="fa-solid fa-circle-exclamation"></i>
            <div><%= error %></div>
          </div>
        <% } %>

        <!-- Hidden inputs class and date filters -->
        <form action="/teacher/attendance" method="GET" id="attendanceFilterForm" class="d-none">
          <input type="hidden" name="classId" id="selectedClassIdInput" value="<%= selectedClassId || '' %>">
          <input type="date" name="date" id="attendanceDateInput" value="<%= selectedDate %>">
        </form>

        <!-- Class Timings Top Violet Bar with Export as JPG Button -->
        <% if (selectedClassId && selectedClass) { %>
          <% 
            const sTime = selectedClass.startTime || '08:30:00';
            const eTime = selectedClass.endTime || '09:30:00';
            const gTime = selectedClass.graceTime || 10;

            const formatTime12 = (tStr) => {
              if(!tStr) return '';
              const parts = tStr.split(':');
              const hrs = parseInt(parts[0]);
              const mins = parts[1];
              const ampm = hrs >= 12 ? 'PM' : 'AM';
              const displayHrs = hrs % 12 || 12;
              return `${displayHrs}:${mins} ${ampm}`;
            };
          %>
          <div class="app-bar-violet mx-3">
            <div>
              <h1 class="app-bar-title"><%= selectedClass.name %></h1>
              <div class="app-bar-sub"><%= formatTime12(sTime) %> - <%= formatTime12(eTime) %></div>
            </div>
            <!-- Export as JPG Button (No other buttons needed at bottom) -->
            <button type="button" class="btn btn-light fw-bold px-3 py-2" onclick="alert('Exporting sheet to JPG...')" style="border-radius:10px; color:#6d28d9; border:none; font-size:13px; box-shadow:0 2px 8px rgba(0,0,0,0.1);">
              <i class="fa-solid fa-download me-1"></i> Export as JPG
            </button>
          </div>

          <!-- Date Navigation Card -->
          <div class="date-card mx-3">
            <button type="button" class="date-btn" id="prevDayBtn">
              <i class="fa-solid fa-chevron-left"></i>
            </button>
            <div class="date-display">
              <% 
                const selectedDateObj = new Date(selectedDate);
                const displayDateStr = selectedDateObj.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
                const displayDayStr = selectedDateObj.toLocaleDateString('en-US', { weekday: 'long' });
              %>
              <div class="date-main"><%= displayDateStr %></div>
              <div class="date-sub"><%= displayDayStr %></div>
            </div>
            <button type="button" class="date-btn" id="nextDayBtn">
              <i class="fa-solid fa-chevron-right"></i>
            </button>
          </div>

          <!-- Single Selected Class Header & Switch Class Button -->
          <div class="px-3 mb-3 d-flex align-items-center justify-content-between">
            <h5 class="fw-bold text-dark m-0">
              <i class="fa-solid fa-graduation-cap text-primary me-2"></i><%= selectedClass ? selectedClass.name : 'Class Workspace' %>
            </h5>
            <a href="/teacher/select-class" class="btn btn-sm btn-outline-warning text-dark fw-bold rounded-pill px-3 shadow-xs">
              <i class="fa-solid fa-rotate me-1"></i> Switch Class
            </a>
          </div>

          <!-- Student Cards List -->
          <div class="px-3">
            <% if (students.length === 0) { %>
              <div class="text-muted text-center py-5 bg-white rounded-3 shadow-sm">
                <i class="fa-solid fa-users-slash fa-3x mb-3 text-light"></i>
                <p class="mb-0 fw-semibold">No students currently enrolled in this class.</p>
              </div>
            <% } else { %>
              <div class="student-cards-container">
                <% students.forEach((student, index) => { %>
                  <% 
                    const record = attendanceMap[student.id] || {};
                    const existingStatus = record.status || 'Absent';
                    const checkInVal = record.checkInTime ? record.checkInTime.slice(0, 5) : '';
                    const isChecked = existingStatus === 'Present' || existingStatus === 'Late';
                  %>
                  <div class="student-card student-row" data-student-id="<%= student.id %>" data-student-name="<%= student.name %>">
                    
                    <!-- Left side info -->
                    <div class="student-left">
                      <div class="roll-badge"><%= index + 1 %></div>
                      <div class="student-info">
                        <div class="student-name">
                          <span><%= student.name %></span>
                          <span class="status-badge-container" id="badge_container_<%= student.id %>">
                            <% if (existingStatus === 'Late') { %>
                              <span class="badge bg-warning text-dark" style="font-size:10px; padding:3px 6px;">LATE <%= checkInVal %></span>
                            <% } else if (existingStatus === 'Present') { %>
                              <span class="badge bg-success text-white" style="font-size:10px; padding:3px 6px;">PRESENT <%= checkInVal %></span>
                            <% } %>
                          </span>
                        </div>
                        <div class="student-roll">Roll: <%= index + 1 %></div>
                      </div>
                    </div>
                    
                    <!-- Right side action button -->
                    <div class="mark-action-area">
                      <!-- Hidden Form Fields (for state tracking) -->
                      <input type="hidden" id="hidden_checked_<%= student.id %>" value="<%= isChecked ? 'true' : 'false' %>">
                      <input type="hidden" id="hidden_time_<%= student.id %>" value="<%= checkInVal %>">

                      <!-- Green Tick Trigger Button -->
                      <div class="attendance-trigger-btn long-press-target" data-student-id="<%= student.id %>" id="trigger_<%= student.id %>" style="transition: transform 0.15s ease;">
                        <% if (isChecked) { %>
                          <i class="fa-solid fa-circle-check tick-icon-present"></i>
                        <% } else { %>
                          <i class="fa-regular fa-circle-check tick-icon-absent"></i>
                        <% } %>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <div class="card border-0 shadow-sm bg-white p-5 text-center mx-3 my-4">
            <i class="fa-solid fa-clipboard-list fa-4x text-light mb-3"></i>
            <h5 class="fw-semibold text-secondary">No classes assigned.</h5>
          </div>
        <% } %>

      </div><!-- /.container-fluid -->
    </div><!-- /.main-content -->
  </div><!-- /.page-right -->
</div><!-- /.wrapper -->

<!-- Custom Time override modal -->
<div class="modal fade" id="customTimeModal" tabindex="-1" aria-labelledby="customTimeModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">
      <div class="modal-header py-3">
        <h6 class="modal-title fw-bold" id="customTimeModalLabel">Edit Check-in Time</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="small text-secondary mb-3">Enter custom check-in time for <strong id="modalStudentName" class="text-dark"></strong>:</p>
        <div class="mb-3">
          <input type="time" id="overrideTimeInput" class="form-control text-center fs-4 p-2" required>
        </div>
      </div>
      <div class="modal-footer py-2">
        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-sm btn-primary-vivid" id="saveCustomTimeBtn">Save Time</button>
      </div>
    </div>
  </div>
</div>

<!-- Scripts for select, green tick toggle & long-press -->
<script>
  // Quick Change Class Helper
  function selectClass(id) {
    document.getElementById('selectedClassIdInput').value = id;
    document.getElementById('attendanceFilterForm').submit();
  }

  document.addEventListener("DOMContentLoaded", function() {

    // ── 1. Date Navigation Handlers ──
    const dateInput = document.getElementById('attendanceDateInput');
    
    const changeDate = (days) => {
      const currentDate = new Date(dateInput.value);
      currentDate.setDate(currentDate.getDate() + days);
      const yyyy = currentDate.getFullYear();
      const mm = String(currentDate.getMonth() + 1).padStart(2, '0');
      const dd = String(currentDate.getDate()).padStart(2, '0');
      dateInput.value = `${yyyy}-${mm}-${dd}`;
      document.getElementById('attendanceFilterForm').submit();
    };

    const prevBtn = document.getElementById('prevDayBtn');
    const nextBtn = document.getElementById('nextDayBtn');
    if (prevBtn) prevBtn.addEventListener('click', () => changeDate(-1));
    if (nextBtn) nextBtn.addEventListener('click', () => changeDate(1));

    // Class timings logic
    <% if (selectedClassId && selectedClass) { %>
      const classStart = "<%= selectedClass.startTime || '08:30:00' %>";
      const classEnd = "<%= selectedClass.endTime || '09:30:00' %>";
      const graceTimeMins = parseInt("<%= selectedClass.graceTime || 10 %>");

      // Parse time to minutes from midnight
      const parseTimeToMinutes = (tStr) => {
        const parts = tStr.split(':');
        return parseInt(parts[0]) * 60 + parseInt(parts[1]);
      };

      const classStartMin = parseTimeToMinutes(classStart);
      const classEndMin = parseTimeToMinutes(classEnd);
      const graceLimitMin = classStartMin + graceTimeMins;

      // Recalculate status client-side for dynamic rendering
      const getStatusLabel = (checkInTime) => {
        if (!checkInTime) {
          return {
            status: 'Absent',
            badgeHtml: '',
            iconHtml: '<i class="fa-regular fa-circle-check tick-icon-absent"></i>'
          };
        }
        
        const checkInMin = parseTimeToMinutes(checkInTime);
        const formatTime = checkInTime.slice(0, 5);

        if (checkInMin <= graceLimitMin) {
          return {
            status: 'Present',
            badgeHtml: `<span class="badge bg-success text-white" style="font-size:10px; padding:3px 6px;">PRESENT ${formatTime}</span>`,
            iconHtml: '<i class="fa-solid fa-circle-check tick-icon-present"></i>'
          };
        } else if (checkInMin <= classEndMin) {
          return {
            status: 'Late',
            badgeHtml: `<span class="badge bg-warning text-dark" style="font-size:10px; padding:3px 6px;">LATE ${formatTime}</span>`,
            iconHtml: '<i class="fa-solid fa-circle-check tick-icon-present"></i>'
          };
        } else {
          // Absent (too late)
          return {
            status: 'Absent',
            badgeHtml: '',
            iconHtml: '<i class="fa-regular fa-circle-check tick-icon-absent"></i>'
          };
        }
      };

      // ── 2. Click checkbox toggle behavior with AJAX ──
      document.querySelectorAll('.attendance-trigger-btn').forEach(btn => {
        btn.addEventListener('click', async function() {
          if (this.classList.contains('holding')) return; // ignore standard click when holding

          const studentId = this.getAttribute('data-student-id');
          const hiddenChecked = document.getElementById(`hidden_checked_${studentId}`);
          const hiddenTime = document.getElementById(`hidden_time_${studentId}`);
          const badgeContainer = document.getElementById(`badge_container_${studentId}`);

          const isCurrentlyChecked = hiddenChecked.value === 'true';
          let checkedVal = 'false';
          let timeVal = '';

          if (!isCurrentlyChecked) {
            const now = new Date();
            const hrs = String(now.getHours()).padStart(2, '0');
            const mins = String(now.getMinutes()).padStart(2, '0');
            checkedVal = 'true';
            timeVal = `${hrs}:${mins}`;
          }

          // Trigger a quick click scale-up effect
          this.style.transform = 'scale(1.15)';
          setTimeout(() => { this.style.transform = 'scale(1)'; }, 150);

          try {
            // Save instantly in the background via fetch AJAX
            const response = await fetch('/teacher/attendance/save-single', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                classId: "<%= selectedClassId %>",
                date: "<%= selectedDate %>",
                studentId: studentId,
                checked: checkedVal,
                checkInTime: timeVal
              })
            });

            const data = await response.json();
            if (data.success) {
              hiddenChecked.value = checkedVal;
              hiddenTime.value = timeVal;

              const res = getStatusLabel(timeVal);
              this.innerHTML = res.iconHtml;
              badgeContainer.innerHTML = res.badgeHtml;
            } else {
              alert('Failed to save attendance. Try again.');
            }
          } catch (err) {
            console.error('Error saving attendance:', err);
            alert('Connection error. Attendance not saved.');
          }
        });
      });

      // ── 3. Long Press holding handler (3 seconds) ──
      let holdTimer = null;
      let activeStudentIdForOverride = null;
      const modal = new bootstrap.Modal(document.getElementById('customTimeModal'));

      document.querySelectorAll('.long-press-target').forEach(target => {
        const studentId = target.getAttribute('data-student-id');
        const studentName = target.closest('.student-row').getAttribute('data-student-name');

        const startHold = () => {
          target.classList.remove('holding');
          holdTimer = setTimeout(() => {
            target.classList.add('holding');
            if ('vibrate' in navigator) navigator.vibrate(50);
            
            activeStudentIdForOverride = studentId;
            document.getElementById('modalStudentName').textContent = studentName;
            
            const existingTime = document.getElementById(`hidden_time_${studentId}`).value;
            const now = new Date();
            const hrs = String(now.getHours()).padStart(2, '0');
            const mins = String(now.getMinutes()).padStart(2, '0');
            document.getElementById('overrideTimeInput').value = existingTime || `${hrs}:${mins}`;

            modal.show();
          }, 1500); // 1.5 seconds is standard for long presses
        };

        const cancelHold = () => {
          if (holdTimer) clearTimeout(holdTimer);
          setTimeout(() => {
            target.classList.remove('holding');
          }, 200);
        };

        // Event listeners for long press
        target.addEventListener('mousedown', startHold);
        target.addEventListener('touchstart', startHold, { passive: true });
        
        target.addEventListener('mouseup', cancelHold);
        target.addEventListener('mouseleave', cancelHold);
        target.addEventListener('touchend', cancelHold);
        target.addEventListener('touchcancel', cancelHold);
      });

      // Save custom time button in Modal with AJAX
      document.getElementById('saveCustomTimeBtn').addEventListener('click', async function() {
        if (!activeStudentIdForOverride) return;

        const customTime = document.getElementById('overrideTimeInput').value;
        if (!customTime) return;

        const hiddenChecked = document.getElementById(`hidden_checked_${activeStudentIdForOverride}`);
        const hiddenTime = document.getElementById(`hidden_time_${activeStudentIdForOverride}`);
        const trigger = document.getElementById(`trigger_${activeStudentIdForOverride}`);
        const badgeContainer = document.getElementById(`badge_container_${activeStudentIdForOverride}`);

        try {
          const response = await fetch('/teacher/attendance/save-single', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              classId: "<%= selectedClassId %>",
              date: "<%= selectedDate %>",
              studentId: activeStudentIdForOverride,
              checked: 'true',
              checkInTime: customTime
            })
          });

          const data = await response.json();
          if (data.success) {
            hiddenChecked.value = 'true';
            hiddenTime.value = customTime;

            const res = getStatusLabel(customTime);
            trigger.innerHTML = res.iconHtml;
            badgeContainer.innerHTML = res.badgeHtml;
          } else {
            alert('Failed to save custom time.');
          }
        } catch (err) {
          console.error(err);
          alert('Connection error.');
        }

        modal.hide();
        activeStudentIdForOverride = null;
      });
    <% } %>
  });
</script>

<%- include('../partials/footer') %>
