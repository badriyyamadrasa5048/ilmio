<%- include('../partials/header', { pageTitle: 'Select Your Class — Teacher Portal' }) %>

<style>
  .class-hero-card {
    background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
    border-radius: 24px;
    padding: 32px;
    color: white;
    box-shadow: 0 20px 30px -10px rgba(49, 46, 129, 0.3);
    margin-bottom: 32px;
  }

  .class-select-card {
    background: white;
    border-radius: 20px;
    padding: 24px;
    border: 2px solid #f1f5f9;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.03);
    transition: all 0.25s ease-in-out;
  }

  .class-select-card:hover {
    transform: translateY(-6px);
    border-color: #6366f1;
    box-shadow: 0 20px 25px -5px rgba(99, 102, 241, 0.15);
  }

  .class-icon-badge {
    width: 54px;
    height: 54px;
    border-radius: 16px;
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    box-shadow: 0 8px 15px -3px rgba(99, 102, 241, 0.3);
  }

  .action-btn-pill {
    border-radius: 12px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 600;
    transition: all 0.2s;
  }
</style>

<div class="wrapper">
  <%- include('../partials/sidebar') %>

  <div class="page-right">
    <%- include('../partials/navbar') %>

    <div class="main-content p-4">
      <div class="container-fluid" style="max-width: 1100px;">

        <!-- Hero Header -->
        <div class="class-hero-card">
          <div class="row align-items-center">
            <div class="col-lg-8">
              <span class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill mb-3">
                <i class="fa-solid fa-graduation-cap me-1"></i> Teacher Portal
              </span>
              <h2 class="fw-bold mb-2">Assalamu Alaikum, <%= teacher ? teacher.name : user.username %>!</h2>
              <p class="text-white-50 mb-0 lead fs-6">
                Please select a class to view students, mark attendance, record marks, and review tasks.
              </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
              <div class="bg-white bg-opacity-10 p-3 rounded-4 backdrop-blur d-inline-block text-start">
                <div class="small text-white-50">Total Available Classes</div>
                <div class="fs-3 fw-bold text-white"><%= classes.length %> Classes</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Class Selection Section -->
        <div class="d-flex align-items-center justify-content-between mb-4">
          <div>
            <h4 class="fw-bold text-dark m-0">
              <i class="fa-solid fa-school text-primary me-2"></i>Choose Class Workspace
            </h4>
            <span class="text-muted small">Click on any class action below to start managing:</span>
          </div>
        </div>

        <!-- Class Grid -->
        <div class="row g-4 mb-5">
          <% classes.forEach(c => { %>
            <div class="col-md-6 col-lg-4">
              <div class="class-select-card h-100 d-flex flex-column justify-content-between">
                <div>
                  <!-- Card Header -->
                  <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-3">
                      <div class="class-icon-badge">
                        <i class="fa-solid fa-book-open"></i>
                      </div>
                      <div>
                        <h4 class="fw-bold m-0 text-dark"><%= c.name %></h4>
                        <span class="small text-muted">Level <%= c.level || c.id %></span>
                      </div>
                    </div>
                  </div>

                  <p class="text-secondary small mb-3">
                    Room: <strong><%= c.roomNumber || 'Default' %></strong> | Manage students, attendance, tasks & marks for <%= c.name %>.
                  </p>
                </div>

                <!-- Action Grid -->
                <div class="pt-3 border-top">
                  <div class="d-grid gap-2">
                    <a href="/teacher/activate-class/<%= c.id %>?goto=/teacher/attendance" class="btn btn-warning action-btn-pill fw-bold text-dark py-2 shadow-xs">
                      <i class="fa-solid fa-door-open me-2"></i>Enter <%= c.name %> Workspace
                    </a>

                    <div class="row g-2 mt-1">
                      <div class="col-6">
                        <a href="/teacher/activate-class/<%= c.id %>?goto=/teacher/tasks" class="btn btn-outline-indigo action-btn-pill w-100 text-center" style="border-color:#6366f1; color:#6366f1;">
                          <i class="fa-solid fa-list-check me-1"></i>Tasks
                        </a>
                      </div>
                      <div class="col-6">
                        <a href="/teacher/activate-class/<%= c.id %>?goto=/teacher/marks" class="btn btn-outline-success action-btn-pill w-100 text-center">
                          <i class="fa-solid fa-file-signature me-1"></i>Marks
                        </a>
                      </div>
                    </div>

                    <a href="/teacher/activate-class/<%= c.id %>?goto=/teacher/students" class="btn btn-light action-btn-pill text-secondary text-center mt-1">
                      <i class="fa-solid fa-users me-1"></i>View Students List
                    </a>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>

      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
