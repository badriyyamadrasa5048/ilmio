<%- include('../partials/header') %>

<style>
  /* Mobile App-like Violet Theme Styles for Tasks */
  body {
    background-color: #faf8fd !important;
  }
  
  .app-bar-violet {
    background: linear-gradient(135deg, #7c3aed, #5b21b6);
    color: white;
    border-radius: 18px;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 4px 15px rgba(124, 58, 237, 0.15);
    margin-bottom: 20px;
  }

  .app-bar-title {
    font-size: 22px;
    font-weight: 700;
    margin: 0;
    color: white;
  }

  .app-bar-sub {
    font-size: 13px;
    opacity: 0.85;
    margin-top: 4px;
    font-weight: 500;
  }

  /* Segment Control Row */
  .segment-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .segment-control {
    background: #eef2f6;
    border-radius: 14px;
    padding: 4px;
    display: flex;
    gap: 4px;
    flex: 1;
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.03);
  }

  .segment-btn {
    flex: 1;
    border: none;
    background: transparent;
    padding: 10px 16px;
    font-weight: 700;
    font-size: 13.5px;
    color: #64748b;
    border-radius: 10px;
    transition: all 0.2s;
  }

  .segment-btn.active {
    background: #7c3aed;
    color: white;
    box-shadow: 0 4px 10px rgba(124, 58, 237, 0.2);
  }

  .plus-btn-circle {
    background: #7c3aed;
    color: white;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    box-shadow: 0 4px 10px rgba(124, 58, 237, 0.3);
    cursor: pointer;
    transition: transform 0.1s;
  }

  .plus-btn-circle:active {
    transform: scale(0.95);
  }

  /* Date selector */
  .date-card {
    background: #f5f3ff;
    border-radius: 16px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    border: 1.5px solid #ddd6fe;
  }

  .date-btn {
    background: white;
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #7c3aed;
    box-shadow: 0 2px 4px rgba(109, 40, 217, 0.05);
    cursor: pointer;
    transition: transform 0.1s;
  }

  .date-btn:active {
    transform: scale(0.95);
  }

  .date-display {
    text-align: center;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .date-main {
    font-size: 16px;
    font-weight: 700;
    color: #1f2937;
  }

  /* Grid Table style */
  .task-table-container {
    background: white;
    border-radius: 16px;
    border: 1px solid #eef2f6;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(109, 40, 217, 0.02);
  }

  .task-cell-interactive {
    cursor: pointer;
    text-align: center;
    vertical-align: middle;
    transition: background 0.1s;
  }

  .task-cell-interactive:active {
    background: #f5f3ff;
  }

  .roll-badge {
    background: #f97316;
    color: white;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 13px;
    margin-right: 10px;
  }

  .percentage-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    color: #10b981;
    margin-top: 2px;
  }

  /* Slider Modal style (Right side screenshot) */
  .range-value-display {
    font-size: 52px;
    font-weight: 800;
    color: #3b82f6;
    text-align: center;
    margin-bottom: 20px;
  }
</style>

<div class="wrapper">
  <%- include('../partials/sidebar') %>

  <div class="page-right">
    <%- include('../partials/navbar') %>

    <div class="main-content">
      <div class="container-fluid" style="max-width: 540px; margin: 0 auto; padding: 0;">

        <!-- Success/Error Alerts -->
        <% if (success) { %>
          <div class="flash-success mx-3 my-2">
            <i class="fa-solid fa-circle-check"></i>
            <div><%= success %></div>
          </div>
        <% } %>
        <% if (error) { %>
          <div class="flash-error mx-3 my-2">
            <i class="fa-solid fa-circle-exclamation"></i>
            <div><%= error %></div>
          </div>
        <% } %>

        <!-- Filter Form -->
        <form action="/teacher/tasks" method="GET" id="taskFilterForm" class="d-none">
          <input type="hidden" name="classId" id="selectedClassIdInput" value="<%= selectedClassId || '' %>">
          <input type="date" name="date" id="taskDateInput" value="<%= selectedDate %>">
          <input type="hidden" name="tab" id="selectedTabInput" value="<%= activeTab %>">
        </form>

        <!-- Top Bar Bar (Violet Gradient Theme) -->
        <% if (selectedClassId && selectedClass) { %>
          <% 
            const sTime = selectedClass.startTime || '08:00:00';
            const eTime = selectedClass.endTime || '09:15:00';
            const formatTime12 = (tStr) => {
              if(!tStr) return '';
              const parts = tStr.split(':');
              const hrs = parseInt(parts[0]);
              const mins = parts[1];
              const ampm = hrs >= 12 ? 'PM' : 'AM';
              const displayHrs = hrs % 12 || 12;
              return `${displayHrs}:${mins} ${ampm}`;
            };
          %>
          <div class="app-bar-violet mx-3">
            <div>
              <h1 class="app-bar-title"><%= selectedClass.name %></h1>
              <div class="app-bar-sub"><%= formatTime12(sTime) %> - <%= formatTime12(eTime) %></div>
            </div>
            <!-- Gear Settings Icon to open Task Manager modal -->
            <button type="button" class="btn btn-link text-white p-0" data-bs-toggle="modal" data-bs-target="#manageTasksModal" style="font-size: 22px;">
              <i class="fa-solid fa-gear"></i>
            </button>
          </div>

          <!-- Segment Toggle + Plus Button Row -->
          <div class="segment-wrapper mx-3">
            <div class="segment-control">
              <button type="button" class="segment-btn <%= activeTab === 'routines' ? 'active' : '' %>" onclick="switchTab('routines')">Routines</button>
              <button type="button" class="segment-btn <%= activeTab === 'tasks' ? 'active' : '' %>" onclick="switchTab('tasks')">Tasks</button>
            </div>
            <!-- Add Button -->
            <button type="button" class="plus-btn-circle" data-bs-toggle="modal" data-bs-target="#addTaskModal">
              <i class="fa-solid fa-plus"></i>
            </button>
          </div>

          <!-- Date Navigation Card (Only for Daily Routines) -->
          <% if (activeTab === 'routines') { %>
            <div class="date-card mx-3">
              <button type="button" class="date-btn" id="prevDayBtn">
                <i class="fa-solid fa-chevron-left"></i>
              </button>
              <div class="date-display">
                <i class="fa-regular fa-calendar text-primary fs-5"></i>
                <% 
                  const selectedDateObj = new Date(selectedDate);
                  const displayDateStr = selectedDateObj.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
                %>
                <div class="date-main"><%= displayDateStr %></div>
              </div>
              <button type="button" class="date-btn" id="nextDayBtn">
                <i class="fa-solid fa-chevron-right"></i>
              </button>
            </div>
          <% } %>

          <!-- Class Selector Pill Row -->
          <div class="px-3 mb-4">
            <div class="d-flex gap-2 overflow-x-auto pb-2" style="white-space: nowrap;">
              <% classes.forEach(c => { %>
                <button type="button" class="btn btn-sm <%= selectedClassId == c.id ? 'btn-violet text-white fw-bold' : 'btn-outline-secondary' %> px-3" onclick="selectClass('<%= c.id %>')" style="border-radius:20px;">
                  <%= c.name %>
                </button>
              <% }) %>
            </div>
          </div>

          <!-- Grid spreadsheet View -->
          <div class="px-3">
            <div class="task-table-container">
              <div class="table-responsive">
                <table class="table align-middle mb-0" style="font-size: 13.5px; border-collapse: collapse;">
                  <thead>
                    <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0; color:#475569; font-weight: 700;">
                      <th style="padding: 14px 16px; width: 45%;">Students</th>
                      <% activeTasks.forEach(task => { %>
                        <th class="text-center" style="padding: 14px 8px; min-width: 90px;">
                          <div class="d-flex align-items-center justify-content-center gap-1">
                            <span><%= task.title %></span>
                            <% if (task.creatorId === user.userId) { %>
                              <form action="/teacher/tasks/delete/<%= task.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete task &quot;<%= task.title %>&quot;?');" class="d-inline">
                                <button type="submit" class="btn btn-link p-0 text-danger border-0 ms-1" style="font-size: 11px;" title="Delete Task">
                                  <i class="fa-solid fa-trash-can"></i>
                                </button>
                              </form>
                            <% } %>
                          </div>
                          <% if (task.requiresPercentage) { %>
                            <span class="text-secondary" style="font-size: 9px; font-weight: normal; display:block;">(Marks)</span>
                          <% } %>
                        </th>
                      <% }) %>
                      <% if (activeTasks.length === 0) { %>
                        <th class="text-center text-muted fw-normal" style="padding:14px;">No active tasks / routines.</th>
                      <% } %>
                    </tr>
                  </thead>
                  <tbody>
                    <% students.forEach((student, sIdx) => { %>
                      <tr style="border-bottom: 1px solid #f1f5f9;">
                        <td style="padding: 12px 16px; font-weight: 700; color: #1e293b;">
                          <div class="d-flex align-items-center">
                            <span class="roll-badge"><%= sIdx + 1 %></span>
                            <span><%= student.name %></span>
                          </div>
                        </td>
                        <% activeTasks.forEach(task => { %>
                          <% 
                            const record = (completionMap[student.id] && completionMap[student.id][task.id]) || {};
                            const isCompleted = record.completed || false;
                            const percentageVal = record.percentage;
                          %>
                          <td class="task-cell-interactive" 
                              style="padding:12px 6px;"
                              data-student-id="<%= student.id %>"
                              data-student-name="<%= student.name %>"
                              data-task-id="<%= task.id %>"
                              data-task-title="<%= task.title %>"
                              data-requires-percentage="<%= task.requiresPercentage %>"
                              data-completed="<%= isCompleted %>"
                              data-percentage="<%= percentageVal || '' %>"
                              id="cell_<%= student.id %>_<%= task.id %>">
                            
                            <div class="cell-content">
                              <% if (isCompleted) { %>
                                <i class="fa-solid fa-circle-check fs-2 text-success"></i>
                                <% if (task.requiresPercentage && percentageVal !== null) { %>
                                  <span class="percentage-label"><%= percentageVal %>%</span>
                                <% } %>
                              <% } else { %>
                                <i class="fa-regular fa-circle fs-2 text-secondary" style="opacity: 0.3;"></i>
                              <% } %>
                            </div>
                          </td>
                        <% }) %>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Simple Parent Completed Tasks View -->
          <div class="px-3 mt-4 mb-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
              <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-3">
                <div>
                  <h6 class="fw-bold m-0 text-dark">
                    <i class="fa-solid fa-house-user text-warning me-2 fs-5"></i>Parent Completed Routines & Tasks
                  </h6>
                  <span class="small text-muted">Home tasks marked by parents for students in this class</span>
                </div>
                <span class="badge bg-success fs-6 px-3 py-2 rounded-pill"><%= parentCompletions ? parentCompletions.length : 0 %> Total Completed</span>
              </div>

              <% if (parentCompletions && parentCompletions.length > 0) { %>
                <div class="row g-3">
                  <% 
                    // Group completions by Student for simple view
                    const completionsByStudent = {};
                    parentCompletions.forEach(pc => {
                      const sName = pc.student ? pc.student.name : ('Student #' + pc.studentId);
                      if (!completionsByStudent[sName]) completionsByStudent[sName] = [];
                      completionsByStudent[sName].push(pc);
                    });
                  %>

                  <% Object.keys(completionsByStudent).forEach(sName => { %>
                    <% const list = completionsByStudent[sName]; %>
                    <div class="col-md-6">
                      <div class="border rounded-3 p-3 bg-light h-100">
                        <div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-2">
                          <span class="fw-bold text-primary"><i class="fa-solid fa-user-graduate me-2"></i><%= sName %></span>
                          <span class="badge bg-info text-dark"><%= list.length %> Tasks</span>
                        </div>
                        <div class="d-flex flex-column gap-2">
                          <% list.forEach(item => { %>
                            <div class="d-flex align-items-center justify-content-between bg-white p-2 rounded-2 border-start border-3 border-success shadow-xs">
                              <div>
                                <span class="fw-semibold text-dark small"><%= item.task ? item.task.title : 'Task #' + item.taskId %></span>
                                <span class="d-block text-muted" style="font-size: 11px;"><%= item.date || (item.updatedAt ? new Date(item.updatedAt).toLocaleDateString('en-GB') : '') %></span>
                              </div>
                              <span class="badge bg-success-subtle text-success border border-success fw-bold">
                                <i class="fa-solid fa-check me-1"></i><%= item.percentage ? item.percentage + '%' : 'Done' %>
                              </span>
                            </div>
                          <% }) %>
                        </div>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="text-center py-5 text-muted">
                  <i class="fa-solid fa-list-check fa-3x mb-3 text-secondary opacity-50"></i>
                  <p class="mb-0 fw-semibold">No parent-completed tasks recorded for this class yet.</p>
                </div>
              <% } %>
            </div>
          </div>
        <% } else { %>
          <div class="card border-0 shadow-sm bg-white p-5 text-center mx-3 my-4">
            <i class="fa-solid fa-clipboard-list fa-4x text-light mb-3"></i>
            <h5 class="fw-semibold text-secondary">No classes assigned.</h5>
          </div>
        <% } %>

      </div><!-- /.container-fluid -->
    </div><!-- /.main-content -->
  </div><!-- /.page-right -->
</div><!-- /.wrapper -->

<!-- Percentage range slider modal (Enter Marks Modal) -->
<div class="modal fade" id="enterMarksModal" tabindex="-1" aria-labelledby="enterMarksModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content" style="border-radius: 20px;">
      <div class="modal-body p-4 text-center">
        <h5 class="fw-bold mb-3" id="marksModalTitle">Enter Marks</h5>
        <p class="small text-secondary mb-4" id="marksModalSubtitle"></p>
        
        <div class="range-value-display" id="rangeValueDisplay">50%</div>

        <div class="mb-4 px-2">
          <input type="range" class="form-range" id="percentageSlider" min="0" max="100" value="50" style="height: 6px;">
          <div class="d-flex justify-content-between text-muted small mt-2">
            <span>0%</span>
            <span>100%</span>
          </div>
        </div>

        <div class="d-flex gap-2">
          <button type="button" class="btn btn-light w-50 fw-bold" data-bs-dismiss="modal" style="border-radius: 12px; padding:10px;">Cancel</button>
          <button type="button" class="btn btn-primary w-50 fw-bold" id="savePercentageBtn" style="border-radius: 12px; padding:10px; background:#3b82f6; border:none;">Save</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Manage Tasks Modal (List and Delete) -->
<div class="modal fade" id="manageTasksModal" tabindex="-1" aria-labelledby="manageTasksModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="manageTasksModalLabel">Manage My Tasks</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <% if (createdTasks.length === 0) { %>
          <div class="text-muted text-center py-4">No tasks currently defined by you.</div>
        <% } else { %>
          <div class="list-group list-group-flush">
            <% createdTasks.forEach(task => { %>
              <div class="list-group-item d-flex justify-content-between align-items-center py-3 px-0">
                <div>
                  <div class="fw-bold text-dark"><%= task.title %></div>
                  <div class="small text-secondary mt-1">
                    Class: <%= task.class ? task.class.name : 'All' %> | <%= task.type === 'daily' ? 'Daily Routine' : 'Permanent Task' %>
                  </div>
                  <div class="small text-indigo mt-1" style="font-size: 11px;">
                    Assigned to: <%= task.targetRole === 'teacher' ? 'Teachers' : 'Parents' %>
                    <% if(task.requiresPercentage) { %> | Slider scale<% } %>
                  </div>
                </div>
                <form action="/teacher/tasks/delete/<%= task.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this task?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius:8px;">
                    <i class="fa-solid fa-trash-can"></i>
                  </button>
                </form>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Create Task Modal -->
<% if (classes.length > 0) { %>
  <div class="modal fade" id="addTaskModal" tabindex="-1" aria-labelledby="addTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title fw-bold" id="addTaskModalLabel">Create New Class Task</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form action="/teacher/tasks/create" method="POST">
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label-modern" for="title">Task Name</label>
              <input type="text" name="title" id="title" class="form-control-modern" placeholder="Enter task name" required>
            </div>
            
            <div class="mb-3">
              <label class="form-label-modern" for="description">Description (optional)</label>
              <input type="text" name="description" id="description" class="form-control-modern" placeholder="Enter brief details">
            </div>

            <div class="row mb-3">
              <div class="col-md-6">
                <label class="form-label-modern" for="type">Type</label>
                <select name="type" id="type" class="form-select-modern" required>
                  <option value="daily">Daily Routine</option>
                  <option value="permanent">Permanent</option>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label-modern" for="classId">Class</label>
                <select name="classId" id="classId" class="form-select-modern" required>
                  <% classes.forEach(c => { %>
                    <option value="<%= c.id %>"><%= c.name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-12 mt-3">
                <label class="form-label-modern" for="targetRole">Assign To</label>
                <select name="targetRole" id="targetRole" class="form-select-modern" required>
                  <option value="parent">Parents</option>
                  <option value="teacher">Teachers</option>
                </select>
              </div>
              <div class="col-md-12 mt-3">
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" name="requiresPercentage" id="requiresPercentage" value="true">
                  <label class="form-check-label fw-bold text-secondary" for="requiresPercentage">Use Score Slider (0-100%)</label>
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn-secondary-vivid" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn-primary-vivid">Create Task</button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% } %>

<!-- Scripts for select, green tick toggle & long-press -->
<script>
  function selectClass(id) {
    document.getElementById('selectedClassIdInput').value = id;
    document.getElementById('taskFilterForm').submit();
  }

  function switchTab(tab) {
    document.getElementById('selectedTabInput').value = tab;
    document.getElementById('taskFilterForm').submit();
  }

  document.addEventListener("DOMContentLoaded", function() {
    // ── 1. Date Navigation Handlers ──
    const dateInput = document.getElementById('taskDateInput');
    
    const changeDate = (days) => {
      if (!dateInput) return;
      const currentDate = new Date(dateInput.value);
      currentDate.setDate(currentDate.getDate() + days);
      const yyyy = currentDate.getFullYear();
      const mm = String(currentDate.getMonth() + 1).padStart(2, '0');
      const dd = String(currentDate.getDate()).padStart(2, '0');
      dateInput.value = `${yyyy}-${mm}-${dd}`;
      document.getElementById('taskFilterForm').submit();
    };

    const prevBtn = document.getElementById('prevDayBtn');
    const nextBtn = document.getElementById('nextDayBtn');
    if (prevBtn) prevBtn.addEventListener('click', () => changeDate(-1));
    if (nextBtn) nextBtn.addEventListener('click', () => changeDate(1));

    // Slider modal references
    const marksModal = new bootstrap.Modal(document.getElementById('enterMarksModal'));
    const slider = document.getElementById('percentageSlider');
    const valueDisplay = document.getElementById('rangeValueDisplay');
    const marksModalSubtitle = document.getElementById('marksModalSubtitle');
    const marksModalTitle = document.getElementById('marksModalTitle');
    let activeCellForSlider = null;

    slider.addEventListener('input', function() {
      valueDisplay.textContent = `${this.value}%`;
    });

    // ── 2. Click cell interactive markings ──
    document.querySelectorAll('.task-cell-interactive').forEach(cell => {
      cell.addEventListener('click', async function() {
        const studentId = this.getAttribute('data-student-id');
        const studentName = this.getAttribute('data-student-name');
        const taskId = this.getAttribute('data-task-id');
        const taskTitle = this.getAttribute('data-task-title');
        const requiresPercentage = this.getAttribute('data-requires-percentage') === 'true';
        const isCompleted = this.getAttribute('data-completed') === 'true';
        const currentPercentage = this.getAttribute('data-percentage');

        if (requiresPercentage) {
          // Open custom range slider modal
          activeCellForSlider = this;
          marksModalTitle.textContent = taskTitle;
          marksModalSubtitle.textContent = `Enter score for ${studentName}`;
          slider.value = currentPercentage ? parseInt(currentPercentage) : 50;
          valueDisplay.textContent = `${slider.value}%`;
          marksModal.show();
        } else {
          // Simple toggle checkmark in background via AJAX
          const nextCompletedState = !isCompleted;
          
          try {
            const response = await fetch('/teacher/tasks/save-single', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                date: "<%= selectedDate %>",
                studentId,
                taskId,
                completed: nextCompletedState ? 'true' : 'false'
              })
            });

            const data = await response.json();
            if (data.success) {
              this.setAttribute('data-completed', nextCompletedState ? 'true' : 'false');
              const cellContent = this.querySelector('.cell-content');
              if (nextCompletedState) {
                cellContent.innerHTML = '<i class="fa-solid fa-circle-check fs-2 text-success"></i>';
              } else {
                cellContent.innerHTML = '<i class="fa-regular fa-circle fs-2 text-secondary" style="opacity: 0.3;"></i>';
              }
            } else {
              alert('Failed to save task completion.');
            }
          } catch (err) {
            console.error(err);
            alert('Connection error.');
          }
        }
      });
    });

    // Save percentage slider value
    document.getElementById('savePercentageBtn').addEventListener('click', async function() {
      if (!activeCellForSlider) return;

      const studentId = activeCellForSlider.getAttribute('data-student-id');
      const taskId = activeCellForSlider.getAttribute('data-task-id');
      const score = slider.value;

      try {
        const response = await fetch('/teacher/tasks/save-single', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            date: "<%= selectedDate %>",
            studentId,
            taskId,
            completed: 'true',
            percentage: score
          })
        });

        const data = await response.json();
        if (data.success) {
          activeCellForSlider.setAttribute('data-completed', 'true');
          activeCellForSlider.setAttribute('data-percentage', score);
          const cellContent = activeCellForSlider.querySelector('.cell-content');
          cellContent.innerHTML = `
            <i class="fa-solid fa-circle-check fs-2 text-success"></i>
            <span class="percentage-label">${score}%</span>
          `;
        } else {
          alert('Failed to save score.');
        }
      } catch (err) {
        console.error(err);
        alert('Connection error.');
      }

      marksModal.hide();
      activeCellForSlider = null;
    });

  });
</script>

