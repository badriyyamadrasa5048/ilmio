<%- include('../partials/header') %>

<div class="wrapper">
  <%- include('../partials/sidebar') %>

  <div class="page-right">
    <%- include('../partials/navbar') %>

    <div class="main-content">
      <div class="container-fluid">

      <!-- Printable Report Header -->
      <div class="print-header">
        <h2>Al-Ilm Madrasa</h2>
        <p>Attendance Record for Student: <%= student.name %></p>
        <p class="small text-secondary">Generated on: <%= new Date().toLocaleDateString() %></p>
      </div>

      <!-- Page Header -->
      <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
        <div>
          <h2 class="fw-bold text-dark mb-1">Attendance Log</h2>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
              <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
              <li class="breadcrumb-item active" aria-current="page">Attendance Log</li>
            </ol>
          </nav>
        </div>
        <button type="button" class="btn btn-warning py-2 px-4 fw-bold hover-lift" onclick="window.print();">
          <i class="fa-solid fa-print me-2"></i>Print Log
        </button>
      </div>

      <!-- Stats Grid -->
      <div class="row g-4 mb-4">
        <!-- Attendance rate card -->
        <div class="col-sm-6 col-md-3">
          <div class="card border-0 shadow-sm bg-white p-3 h-100">
            <h6 class="text-muted mb-2 text-uppercase fw-bold small">Attendance Rate</h6>
            <h3 class="fw-bold mb-0 text-success"><%= stats.attendanceRate %>%</h3>
          </div>
        </div>
        <!-- Present card -->
        <div class="col-sm-6 col-md-3">
          <div class="card border-0 shadow-sm bg-white p-3 h-100">
            <h6 class="text-muted mb-2 text-uppercase fw-bold small">Days Present</h6>
            <h3 class="fw-bold mb-0 text-primary"><%= stats.presentDays %></h3>
          </div>
        </div>
        <!-- Late card -->
        <div class="col-sm-6 col-md-3">
          <div class="card border-0 shadow-sm bg-white p-3 h-100">
            <h6 class="text-muted mb-2 text-uppercase fw-bold small">Days Late</h6>
            <h3 class="fw-bold mb-0 text-warning-emphasis"><%= stats.lateDays %></h3>
          </div>
        </div>
        <!-- Absent card -->
        <div class="col-sm-6 col-md-3">
          <div class="card border-0 shadow-sm bg-white p-3 h-100">
            <h6 class="text-muted mb-2 text-uppercase fw-bold small">Days Absent</h6>
            <h3 class="fw-bold mb-0 text-danger"><%= stats.absentDays %></h3>
          </div>
        </div>
      </div>

      <!-- Logs list -->
      <div class="card border-0 shadow-sm bg-white p-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
          <h5 class="fw-bold m-0 text-dark"><i class="fa-solid fa-history text-secondary me-2"></i>Daily Log History</h5>
          <!-- Date Filter Form -->
          <form action="/parent/attendance" method="GET" class="d-flex flex-wrap gap-2 align-items-center">
            <input type="date" name="startDate" class="form-control form-control-sm" value="<%= typeof startDate !== 'undefined' ? startDate : '' %>">
            <span class="small text-muted">to</span>
            <input type="date" name="endDate" class="form-control form-control-sm" value="<%= typeof endDate !== 'undefined' ? endDate : '' %>">
            <button type="submit" class="btn btn-sm btn-primary fw-bold"><i class="fa-solid fa-filter me-1"></i>Filter</button>
            <% if (typeof startDate !== 'undefined' && (startDate || endDate)) { %>
              <a href="/parent/attendance" class="btn btn-sm btn-outline-secondary">Clear</a>
            <% } %>
          </form>
        </div>

        <% if (attendances.length === 0) { %>
          <div class="text-muted text-center py-5">
            <i class="fa-solid fa-calendar-xmark fa-3x mb-3 text-light"></i>
            <p class="mb-0">No attendance data logged yet for your child.</p>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Date</th>
                  <th>Day</th>
                  <th>Status</th>
                  <th>Teacher Notes</th>
                  <th>Parent Excuse / Remarks</th>
                </tr>
              </thead>
              <tbody>
                <% attendances.forEach(att => { %>
                  <% 
                    const dayName = new Date(att.date).toLocaleDateString(undefined, { weekday: 'long' });
                  %>
                  <tr>
                    <td><span class="fw-semibold text-dark"><%= new Date(att.date).toLocaleDateString() %></span></td>
                    <td><%= dayName %></td>
                    <td>
                      <% if (att.status === 'Present') { %>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2">Present <%= att.checkInTime ? '(' + att.checkInTime.slice(0, 5) + ')' : '' %></span>
                      <% } else if (att.status === 'Absent') { %>
                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2">Absent</span>
                      <% } else if (att.status === 'Late') { %>
                        <span class="badge bg-warning bg-opacity-10 text-warning-emphasis border border-warning border-opacity-25 px-3 py-2">Late <%= att.checkInTime ? '(' + att.checkInTime.slice(0, 5) + ')' : '' %></span>
                      <% } %>
                    </td>
                    <td><span class="text-secondary small"><%= att.notes || '-' %></span></td>
                    <td>
                      <% if (att.status === 'Absent') { %>
                        <form action="/parent/attendance/remarks" method="POST" class="d-flex gap-1 align-items-center m-0">
                          <input type="hidden" name="attendanceId" value="<%= att.id %>">
                          <input type="text" name="parentRemarks" class="form-control form-control-sm py-1 px-2" placeholder="E.g. Sick, Travel" value="<%= att.parentRemarks || '' %>" style="font-size: 11px; border-radius: 6px; border: 1.5px solid var(--border); min-width: 130px;">
                          <button type="submit" class="btn btn-sm btn-primary-vivid py-1 px-2" style="font-size: 10px; border-radius: 6px;">
                            <i class="fa-solid fa-save"></i>
                          </button>
                        </form>
                      <% } else { %>
                        <span class="text-muted small italic">Not Applicable</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
