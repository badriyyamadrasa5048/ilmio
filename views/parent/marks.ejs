<%- include('../partials/header') %>

<div class="wrapper">
  <%- include('../partials/sidebar') %>

  <div class="page-right">
    <%- include('../partials/navbar') %>

    <div class="main-content">
      <div class="container-fluid">

      <!-- Printable Report Header -->
      <div class="print-header">
        <h2>Al-Ilm Madrasa</h2>
        <p>Official Academic Evaluation Transcript</p>
        <p class="small text-secondary">Student Name: <%= student.name %> | Admission No: <%= student.admissionNumber %></p>
        <p class="small text-secondary">Generated on: <%= new Date().toLocaleDateString() %></p>
      </div>

      <!-- Page Header -->
      <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
        <div>
          <h2 class="fw-bold text-dark mb-1">Academic Transcript</h2>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
              <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
              <li class="breadcrumb-item active" aria-current="page">Marks Transcript</li>
            </ol>
          </nav>
        </div>
        <button type="button" class="btn btn-warning py-2 px-4 fw-bold hover-lift" onclick="window.print();">
          <i class="fa-solid fa-print me-2"></i>Print Transcript
        </button>
      </div>

      <!-- Date Filter Form -->
      <div class="card border-0 shadow-sm bg-white p-3 mb-4">
        <form action="/parent/marks" method="GET" class="d-flex flex-wrap gap-2 align-items-center">
          <span class="fw-bold small text-dark me-2"><i class="fa-solid fa-calendar me-1 text-warning"></i>Filter Exam Date:</span>
          <input type="date" name="startDate" class="form-control form-control-sm" style="width: auto;" value="<%= typeof startDate !== 'undefined' ? startDate : '' %>">
          <span class="small text-muted">to</span>
          <input type="date" name="endDate" class="form-control form-control-sm" style="width: auto;" value="<%= typeof endDate !== 'undefined' ? endDate : '' %>">
          <button type="submit" class="btn btn-sm btn-primary fw-bold"><i class="fa-solid fa-filter me-1"></i>Filter</button>
          <% if (typeof startDate !== 'undefined' && (startDate || endDate)) { %>
            <a href="/parent/marks" class="btn btn-sm btn-outline-secondary">Clear Filter</a>
          <% } %>
        </form>
      </div>

      <!-- Marks grouped by Exam Type -->
      <% if (Object.keys(groupedMarks).length === 0) { %>
        <div class="card border-0 shadow-sm bg-white p-5 text-center">
          <i class="fa-solid fa-scroll fa-4x text-light mb-3"></i>
          <h5 class="fw-semibold text-secondary">No academic transcript reports released yet.</h5>
        </div>
      <% } else { %>
        <% Object.keys(groupedMarks).forEach(examType => { %>
          <% 
            const marksList = groupedMarks[examType];
            let totalObtained = 0;
            let totalMax = 0;
            let passCount = 0;
            marksList.forEach(m => {
              totalObtained += m.marksObtained;
              totalMax += m.maxMarks;
              if ((m.marksObtained / m.maxMarks) * 100 >= 50) {
                passCount++;
              }
            });
            const avgPct = totalMax > 0 ? Math.round((totalObtained / totalMax) * 100) : 0;
          %>
          
          <div class="card border-0 shadow-sm bg-white p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
              <h5 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-square-poll-vertical text-warning me-2"></i><%= examType %> Results
              </h5>
              <span class="badge bg-primary px-3 py-2 fw-semibold">
                Term Average: <%= avgPct %>%
              </span>
            </div>

            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Subject Name</th>
                    <th>Date Taken</th>
                    <th>Score Obtained</th>
                    <th>Maximum Score</th>
                    <th>Percentage</th>
                    <th>Result</th>
                  </tr>
                </thead>
                <tbody>
                  <% marksList.forEach(m => { %>
                    <% const pct = Math.round((m.marksObtained / m.maxMarks) * 100); %>
                    <tr>
                      <td><span class="fw-bold text-dark"><%= m.subjectName %></span></td>
                      <td class="text-secondary small"><%= new Date(m.examDate).toLocaleDateString() %></td>
                      <td><span class="fw-bold"><%= m.marksObtained %></span></td>
                      <td><%= m.maxMarks %></td>
                      <td><span class="fw-semibold"><%= pct %>%</span></td>
                      <td>
                        <% if (pct >= 50) { %>
                          <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2">Pass</span>
                        <% } else { %>
                          <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2">Fail</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>

            <div class="mt-4 p-3 bg-light rounded shadow-inner text-end text-secondary small">
              Total Score: <strong class="text-dark"><%= totalObtained %></strong> out of <strong class="text-dark"><%= totalMax %></strong> 
              | Passed: <strong class="text-dark"><%= passCount %></strong> / <%= marksList.length %> subjects
            </div>
          </div>
        <% }) %>
      <% } %>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
