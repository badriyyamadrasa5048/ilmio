<%- include('../partials/header') %>

<div class="wrapper">
  <%- include('../partials/sidebar') %>

  <div class="page-right">
    <%- include('../partials/navbar') %>

    <div class="main-content">
      <div class="container-fluid">

      <!-- Page Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h2 class="fw-bold text-dark mb-1">Student Profile</h2>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
              <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
              <li class="breadcrumb-item active" aria-current="page">Student Profile</li>
            </ol>
          </nav>
        </div>
      </div>

      <div class="row">
        <!-- Main Profile Info -->
        <div class="col-lg-4 mb-4">
          <div class="card border-0 shadow-sm bg-white p-4 text-center h-100">
            <div class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning p-4 rounded-circle mx-auto mb-3" style="width: 100px; height: 100px;">
              <i class="fa-solid fa-user-graduate fa-4x"></i>
            </div>
            <h4 class="fw-bold text-dark mb-1"><%= student.name %></h4>
            <span class="badge bg-light text-dark px-3 py-2 mb-3 fw-bold border">
              Admission No: <%= student.admissionNumber %>
            </span>
            <p class="text-secondary small">
              Enrolled in class: <strong class="text-dark"><%= student.class ? student.class.name : 'Unassigned' %></strong>
            </p>
          </div>
        </div>

        <!-- Details Grid -->
        <div class="col-lg-8 mb-4">
          <div class="card border-0 shadow-sm bg-white p-4 h-100">
            <h5 class="fw-bold mb-4 text-dark border-bottom pb-2">
              <i class="fa-solid fa-circle-info text-primary me-2"></i>Profile Information
            </h5>
            
            <div class="row g-4">
              <!-- Student Personal -->
              <div class="col-md-6">
                <h6 class="fw-bold text-secondary text-uppercase small mb-3">Student Details</h6>
                <div class="mb-3">
                  <div class="text-muted small">Date of Birth</div>
                  <div class="fw-bold text-dark"><%= new Date(student.dateOfBirth).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) %></div>
                </div>
                <div class="mb-3">
                  <div class="text-muted small">Gender</div>
                  <div class="fw-bold text-dark"><%= student.gender %></div>
                </div>
                <div class="mb-3">
                  <div class="text-muted small">Home Address</div>
                  <div class="fw-semibold text-dark"><%= student.address || 'N/A' %></div>
                </div>
              </div>

              <!-- Parent Info -->
              <div class="col-md-6">
                <h6 class="fw-bold text-secondary text-uppercase small mb-3">Parent Details</h6>
                <div class="mb-3">
                  <div class="text-muted small">Parent / Guardian Name</div>
                  <div class="fw-bold text-dark"><%= student.parentName %></div>
                </div>
                <div class="mb-3">
                  <div class="text-muted small">Contact Number</div>
                  <div class="fw-bold text-dark"><%= student.parentPhone %></div>
                </div>
                <div class="mb-3">
                  <div class="text-muted small">Email Address</div>
                  <div class="fw-semibold text-dark"><%= student.parentEmail %></div>
                </div>
              </div>

              <!-- Classroom info -->
              <div class="col-12 mt-4 border-top pt-4">
                <h6 class="fw-bold text-secondary text-uppercase small mb-3">Classroom Assignment</h6>
                <div class="row g-3">
                  <div class="col-sm-4">
                    <div class="text-muted small">Class Location</div>
                    <div class="fw-bold text-dark"><%= student.class ? student.class.roomNumber || 'Room N/A' : 'N/A' %></div>
                  </div>
                  <div class="col-sm-4">
                    <div class="text-muted small">Class Teacher</div>
                    <div class="fw-bold text-primary"><%= student.class && student.class.classTeacher ? student.class.classTeacher.name : 'N/A' %></div>
                  </div>
                  <div class="col-sm-4">
                    <div class="text-muted small">Teacher Contact</div>
                    <div class="fw-bold text-dark"><%= student.class && student.class.classTeacher ? student.class.classTeacher.email : 'N/A' %></div>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
