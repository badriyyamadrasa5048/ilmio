<%- include('../partials/header') %>

<div class="wrapper">
  <%- include('../partials/sidebar') %>

  <div class="page-right">
    <%- include('../partials/navbar') %>

    <div class="main-content">
      <div class="container-fluid">

        <!-- Page Header -->
        <div class="page-header d-flex justify-content-between align-items-center mb-4">
          <div>
            <h1 class="page-title">Manage Tasks & Daily Routines</h1>
            <nav aria-label="breadcrumb">
              <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
                <li class="breadcrumb-item active">Tasks</li>
              </ol>
            </nav>
          </div>
          <button type="button" class="btn btn-primary-vivid px-4" data-bs-toggle="modal" data-bs-target="#addTaskModal">
            <i class="fa-solid fa-plus me-2"></i>Create Task
          </button>
        </div>

        <!-- Success/Error Alerts -->
        <% if (success) { %>
          <div class="flash-success">
            <i class="fa-solid fa-circle-check"></i>
            <div><%= success %></div>
          </div>
        <% } %>
        <% if (error) { %>
          <div class="flash-error">
            <i class="fa-solid fa-circle-exclamation"></i>
            <div><%= error %></div>
          </div>
        <% } %>

        <!-- Tasks Table Panel -->
        <div class="panel">
          <div class="panel-header d-flex justify-content-between align-items-center">
            <h2 class="panel-title">
              <span class="panel-title-icon" style="background:var(--indigo-light);color:var(--indigo);">
                <i class="fa-solid fa-list-check"></i>
              </span>
              All Active Tasks
            </h2>
            <div class="search-box">
              <i class="fa-solid fa-magnifying-glass search-ico"></i>
              <input type="text" placeholder="Search tasks..." id="tableSearch">
            </div>
          </div>

          <div class="panel-body p-0">
            <% if (tasks.length === 0) { %>
              <div class="text-muted text-center py-5">
                <i class="fa-solid fa-clipboard-question fa-3x mb-3 text-light"></i>
                <p class="mb-0 fw-semibold">No tasks currently defined.</p>
              </div>
            <% } else { %>
              <div class="table-responsive">
                <table class="table-modern align-middle mb-0">
                  <thead>
                    <tr>
                      <th style="width: 25%;">Task Title</th>
                      <th style="width: 30%;">Description</th>
                      <th style="width: 15%;">Type</th>
                      <th style="width: 15%;">Target Students</th>
                      <th style="width: 15%;">Creator</th>
                      <th style="width: 10%;" class="text-end">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% tasks.forEach(task => { %>
                      <tr>
                        <td>
                          <div class="fw-bold text-dark"><%= task.title %></div>
                        </td>
                        <td>
                          <span class="text-secondary small"><%= task.description || '—' %></span>
                        </td>
                        <td>
                          <% if (task.type === 'daily') { %>
                            <span class="badge-pill badge-late"><i class="fa-solid fa-calendar-day me-1"></i>Daily Routine</span>
                          <% } else { %>
                            <span class="badge-pill badge-pass"><i class="fa-solid fa-clipboard me-1"></i>Permanent</span>
                          <% } %>
                        </td>
                        <td>
                          <% if (task.classId) { %>
                            <span class="badge bg-light text-primary border border-primary-subtle fw-semibold" style="font-size:12px; padding: 4px 10px; border-radius: 6px;">
                              Class: <%= task.class ? task.class.name : 'Class ID ' + task.classId %>
                            </span>
                          <% } else { %>
                            <span class="badge bg-light text-success border border-success-subtle fw-semibold" style="font-size:12px; padding: 4px 10px; border-radius: 6px;">
                              <i class="fa-solid fa-globe me-1"></i>Everyone
                            </span>
                          <% } %>
                          <div class="mt-1">
                            <% if (task.targetRole === 'teacher') { %>
                              <span class="badge bg-light text-dark border border-dark-subtle fw-semibold" style="font-size:10px; padding: 2px 6px; border-radius: 4px;">For Teachers</span>
                            <% } else { %>
                              <span class="badge bg-light text-indigo border border-indigo-subtle fw-semibold" style="font-size:10px; padding: 2px 6px; border-radius: 4px;">For Parents</span>
                            <% } %>
                          </div>
                        </td>
                        <td class="small text-secondary">
                          <%= task.creator ? task.creator.username : 'System' %>
                        </td>
                        <td class="text-end">
                          <form action="/admin/tasks/delete/<%= task.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this task?');" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 8px; padding: 6px 10px;" title="Delete Task">
                              <i class="fa-solid fa-trash-can"></i>
                            </button>
                          </form>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>

      </div><!-- /.container-fluid -->
    </div><!-- /.main-content -->
  </div><!-- /.page-right -->
</div><!-- /.wrapper -->

<!-- Create Task Modal -->
<div class="modal fade" id="addTaskModal" tabindex="-1" aria-labelledby="addTaskModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="addTaskModalLabel">Create New Task</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/admin/tasks/create" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label-modern" for="title">Task Name</label>
            <input type="text" name="title" id="title" class="form-control-modern" placeholder="Enter task name" required>
          </div>
          
          <div class="mb-3">
            <label class="form-label-modern" for="description">Description (optional)</label>
            <input type="text" name="description" id="description" class="form-control-modern" placeholder="Enter brief details">
          </div>

          <div class="row mb-3">
            <div class="col-md-6">
              <label class="form-label-modern" for="type">Type</label>
              <select name="type" id="type" class="form-select-modern" required>
                <option value="daily">Daily Routine</option>
                <option value="permanent">Permanent</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label-modern" for="classId">Class</label>
              <select name="classId" id="classId" class="form-select-modern" required>
                <option value="all">All Classes</option>
                <% classes.forEach(c => { %>
                  <option value="<%= c.id %>"><%= c.name %></option>
                <% }) %>
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-md-12">
              <label class="form-label-modern" for="targetRole">Assign To</label>
              <select name="targetRole" id="targetRole" class="form-select-modern" required>
                <option value="parent">Parents</option>
                <option value="teacher">Teachers</option>
              </select>
            </div>
            <div class="col-md-12 mt-3">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="requiresPercentage" id="requiresPercentage" value="true">
                <label class="form-check-label fw-bold text-secondary" for="requiresPercentage">Use Score Slider (0-100%)</label>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-secondary-vivid" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn-primary-vivid">Create Task</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
