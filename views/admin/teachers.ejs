<%- include('../partials/header') %>

<div class="wrapper">
  <%- include('../partials/sidebar') %>

  <div class="page-right">
    <%- include('../partials/navbar') %>

    <div class="main-content">
      <div class="container-fluid">

      <!-- Page Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h2 class="fw-bold text-dark mb-1">Teacher Management</h2>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
              <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
              <li class="breadcrumb-item active" aria-current="page">Teachers</li>
            </ol>
          </nav>
        </div>
        <button type="button" class="btn btn-warning py-2 px-4 fw-bold hover-lift" data-bs-toggle="modal" data-bs-target="#addTeacherModal">
          <i class="fa-solid fa-plus me-2"></i>Add Teacher
        </button>
      </div>

      <!-- Alerts -->
      <% if (error) { %>
        <div class="alert alert-danger border-0 shadow-sm mb-4" role="alert">
          <i class="fa-solid fa-circle-exclamation me-2"></i><%= error %>
        </div>
      <% } %>
      <% if (success) { %>
        <div class="alert alert-success border-0 shadow-sm mb-4" role="alert">
          <i class="fa-solid fa-circle-check me-2"></i><%= success %>
        </div>
      <% } %>

      <!-- Filters Section -->
      <div class="card border-0 shadow-sm bg-white p-4 mb-4">
        <form action="/admin/teachers" method="GET" class="row g-3 align-items-end">
          <div class="col-md-9">
            <label class="form-label text-secondary fw-semibold">Search Teacher</label>
            <input type="text" name="search" class="form-control" placeholder="Search by name, email, subject..." value="<%= search %>">
          </div>
          <div class="col-md-3">
            <button type="submit" class="btn btn-dark w-100 py-2">
              <i class="fa-solid fa-search me-2"></i>Search
            </button>
          </div>
        </form>
      </div>

      <!-- Teachers Table -->
      <div class="card border-0 shadow-sm bg-white p-4">
        <% if (teachers.length === 0) { %>
          <div class="text-muted text-center py-5">
            <i class="fa-solid fa-user-slash fa-3x mb-3 text-light"></i>
            <p class="mb-0">No teachers found. Add teachers to populate records.</p>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Name</th>
                  <th>Login Username</th>
                  <th>Phone</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% teachers.forEach(teacher => { %>
                  <tr>
                    <td><span class="fw-bold text-dark"><%= teacher.name %></span></td>
                    <td><code class="text-primary fw-bold"><%= teacher.userAccount ? teacher.userAccount.username : 'N/A' %></code></td>
                    <td><%= teacher.phone || 'N/A' %></td>
                    <td class="text-end">
                      <button type="button" class="btn btn-sm btn-outline-primary me-2 edit-teacher-btn"
                              data-teacher='<%= JSON.stringify(teacher) %>'
                              data-bs-toggle="modal" data-bs-target="#editTeacherModal">
                        <i class="fa-solid fa-pen"></i>
                      </button>
                      
                      <form action="/admin/teachers/delete/<%= teacher.id %>" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this teacher and their portal login? This action is permanent.');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                          <i class="fa-solid fa-trash"></i>
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

    </div>
  </div>
</div>

<!-- ==========================================
     ADD TEACHER MODAL
     ========================================== -->
<div class="modal fade" id="addTeacherModal" tabindex="-1" aria-labelledby="addTeacherModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-dark text-white">
        <h5 class="modal-title fw-bold" id="addTeacherModalLabel">Add New Teacher</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/admin/teachers/create" method="POST">
        <div class="modal-body p-4">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label">Full Name</label>
              <input type="text" name="name" class="form-control" placeholder="Sheikh or Teacher's name" required>
            </div>
            <div class="col-12">
              <label class="form-label">Phone Number (Used as Login)</label>
              <input type="text" name="phone" class="form-control" placeholder="E.g. 9876543210" required>
            </div>
            <div class="col-12">
              <label class="form-label">Login Password</label>
              <input type="password" name="password" class="form-control" placeholder="Set password (default: teacher123)">
            </div>
          </div>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="submit" class="btn btn-warning fw-bold text-dark">Save Teacher</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ==========================================
     EDIT TEACHER MODAL
     ========================================== -->
<div class="modal fade" id="editTeacherModal" tabindex="-1" aria-labelledby="editTeacherModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-dark text-white">
        <h5 class="modal-title fw-bold" id="editTeacherModalLabel">Edit Teacher Details</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="editTeacherForm" action="/admin/teachers/update" method="POST">
        <div class="modal-body p-4">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label">Full Name</label>
              <input type="text" id="edit_name" name="name" class="form-control" required>
            </div>
            <div class="col-12">
              <label class="form-label">Phone Number (Used as Login)</label>
              <input type="text" id="edit_phone" name="phone" class="form-control" required>
            </div>
            <div class="col-12">
              <label class="form-label">New Password (Leave blank to keep unchanged)</label>
              <input type="password" id="edit_password" name="password" class="form-control" placeholder="Enter new password">
            </div>
          </div>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="submit" class="btn btn-warning fw-bold text-dark">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const editButtons = document.querySelectorAll(".edit-teacher-btn");
    const editForm = document.getElementById("editTeacherForm");

    editButtons.forEach(btn => {
      btn.addEventListener("click", function() {
        const teacher = JSON.parse(this.getAttribute("data-teacher"));
        
        document.getElementById("edit_name").value = teacher.name;
        document.getElementById("edit_phone").value = teacher.phone || '';
        document.getElementById("edit_password").value = '';

        editForm.action = `/admin/teachers/update/${teacher.id}`;
      });
    });
  });
</script>

<%- include('../partials/footer') %>
