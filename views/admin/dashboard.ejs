<%- include('../partials/header') %>

<div class="wrapper">
  <%- include('../partials/sidebar') %>

  <div class="page-right">
    <%- include('../partials/navbar') %>

    <div class="main-content">
      <div class="container-fluid">

        <!-- Page Header -->
        <div class="page-header">
          <div>
            <h1 class="page-title">Admin Dashboard</h1>
            <nav aria-label="breadcrumb">
              <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
                <li class="breadcrumb-item active">Dashboard</li>
              </ol>
            </nav>
          </div>
        </div>

        <!-- Stats Cards -->
        <div class="row g-4 mb-4">
          <!-- Students -->
          <div class="col-6 col-lg-3">
            <a href="/admin/students" class="stat-card">
              <div class="stat-icon indigo"><i class="fa-solid fa-graduation-cap"></i></div>
              <div class="stat-info">
                <div class="stat-label">Total Students</div>
                <div class="stat-value"><%= stats.studentCount %></div>
                <div class="stat-link">View all <i class="fa-solid fa-arrow-right"></i></div>
              </div>
            </a>
          </div>
          <!-- Teachers -->
          <div class="col-6 col-lg-3">
            <a href="/admin/teachers" class="stat-card">
              <div class="stat-icon emerald"><i class="fa-solid fa-chalkboard-user"></i></div>
              <div class="stat-info">
                <div class="stat-label">Total Teachers</div>
                <div class="stat-value"><%= stats.teacherCount %></div>
                <div class="stat-link">View all <i class="fa-solid fa-arrow-right"></i></div>
              </div>
            </a>
          </div>
          <!-- Classes -->
          <div class="col-6 col-lg-3">
            <a href="/admin/classes" class="stat-card">
              <div class="stat-icon sky"><i class="fa-solid fa-school"></i></div>
              <div class="stat-info">
                <div class="stat-label">Total Classes</div>
                <div class="stat-value"><%= stats.classCount %></div>
                <div class="stat-link">View all <i class="fa-solid fa-arrow-right"></i></div>
              </div>
            </a>
          </div>
          <!-- Attendance Rate -->
          <div class="col-6 col-lg-3">
            <a href="/admin/reports/attendance" class="stat-card">
              <div class="stat-icon amber"><i class="fa-solid fa-clipboard-user"></i></div>
              <div class="stat-info">
                <div class="stat-label">Attendance Rate</div>
                <div class="stat-value"><%= stats.attendanceRate %>%</div>
                <div class="stat-link">View report <i class="fa-solid fa-arrow-right"></i></div>
              </div>
            </a>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="panel mb-4">
          <div class="panel-header">
            <h2 class="panel-title">
              <span class="panel-title-icon" style="background:var(--violet-light);color:var(--violet);">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
              </span>
              Quick Actions
            </h2>
          </div>
          <div class="panel-body">
            <div class="row g-3">
              <div class="col-6 col-md-3">
                <a href="/admin/students" class="quick-action qa-indigo">
                  <span class="qa-icon"><i class="fa-solid fa-user-plus"></i></span>
                  Add Student
                </a>
              </div>
              <div class="col-6 col-md-3">
                <a href="/admin/teachers" class="quick-action qa-emerald">
                  <span class="qa-icon"><i class="fa-solid fa-user-tie"></i></span>
                  Add Teacher
                </a>
              </div>
              <div class="col-6 col-md-3">
                <a href="/admin/classes" class="quick-action qa-sky">
                  <span class="qa-icon"><i class="fa-solid fa-square-plus"></i></span>
                  Create Class
                </a>
              </div>
              <div class="col-6 col-md-3">
                <a href="/admin/reports/marks" class="quick-action qa-amber">
                  <span class="qa-icon"><i class="fa-solid fa-print"></i></span>
                  Print Reports
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Danger Zone -->
        <div class="panel mb-4" style="border-left: 4px solid var(--rose);">
          <div class="panel-header">
            <h2 class="panel-title" style="color: var(--rose);">
              <span class="panel-title-icon" style="background:var(--rose-light);color:var(--rose);">
                <i class="fa-solid fa-triangle-exclamation"></i>
              </span>
              Danger Zone
            </h2>
          </div>
          <div class="panel-body">
            <p class="mb-3">Formatting the database will delete all students, teachers, classes, attendance, marks, and tasks. Only the default admin account will remain. This action cannot be undone.</p>
            <button class="btn" style="background:var(--rose);color:white;" onclick="confirmFormatDB()">
              <i class="fa-solid fa-trash-can"></i> Format Database (Clean Data)
            </button>
            <form id="formatDbForm" action="/admin/format-database" method="POST" style="display: none;"></form>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<script>
function confirmFormatDB() {
  const confirmation = prompt("WARNING: This will delete ALL data. Type 'FORMAT' to confirm:");
  if (confirmation === 'FORMAT') {
    document.getElementById('formatDbForm').submit();
  } else if (confirmation !== null) {
    alert("Formatting cancelled. You didn't type 'FORMAT' correctly.");
  }
}
</script>
