<%- include('../partials/header') %>

<div class="wrapper">
  <%- include('../partials/sidebar') %>

  <div class="page-right">
    <%- include('../partials/navbar') %>

    <div class="main-content">
      <div class="container-fluid">

      <!-- Printable Report Header -->
      <div class="print-header">
        <h2>Al-Ilm Madrasa</h2>
        <p>Student Academic Evaluation Report</p>
        <p class="small text-secondary">
          Generated on: <%= new Date().toLocaleDateString() %> 
          <% if (filters.subjectName || filters.examType) { %>
            | Criteria: <%= filters.subjectName || 'All Subjects' %> (<%= filters.examType || 'All Exams' %>)
          <% } %>
        </p>
      </div>

      <!-- Page Header -->
      <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
        <div>
          <h2 class="fw-bold text-dark mb-1">Marks Report</h2>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
              <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
              <li class="breadcrumb-item active" aria-current="page">Marks Report</li>
            </ol>
          </nav>
        </div>
        <button type="button" class="btn btn-warning py-2 px-4 fw-bold hover-lift" onclick="window.print();">
          <i class="fa-solid fa-print me-2"></i>Print Report
        </button>
      </div>

      <!-- Filters Section -->
      <div class="card border-0 shadow-sm bg-white p-4 mb-4 d-print-none">
        <form action="/admin/reports/marks" method="GET" class="row g-3 align-items-end">
          <div class="col-md-4">
            <label class="form-label text-secondary fw-semibold">Class Filter</label>
            <select name="classId" class="form-select">
              <option value="">All Classes</option>
              <% classes.forEach(c => { %>
                <option value="<%= c.id %>" <%= filters.classId == c.id ? 'selected' : '' %>><%= c.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label text-secondary fw-semibold">Subject</label>
            <select name="subjectName" class="form-select">
              <option value="">All Subjects</option>
              <% subjects.forEach(sub => { %>
                <option value="<%= sub %>" <%= filters.subjectName == sub ? 'selected' : '' %>><%= sub %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label text-secondary fw-semibold">Exam Type</label>
            <select name="examType" class="form-select">
              <option value="">All Exams</option>
              <% exams.forEach(ex => { %>
                <option value="<%= ex %>" <%= filters.examType == ex ? 'selected' : '' %>><%= ex %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-dark w-100 py-2">
              <i class="fa-solid fa-arrows-spin me-2"></i>Generate
            </button>
          </div>
        </form>
      </div>

      <!-- Analytics Cards -->
      <div class="row g-4 mb-4">
        <!-- Average Percentage -->
        <div class="col-sm-6 col-md-3">
          <div class="card border-0 shadow-sm bg-white p-3 h-100">
            <h6 class="text-muted mb-2 text-uppercase fw-bold small">Average Percentage</h6>
            <h3 class="fw-bold mb-0 text-primary"><%= stats.averagePercentage %>%</h3>
          </div>
        </div>
        <!-- Pass Rate -->
        <div class="col-sm-6 col-md-3">
          <div class="card border-0 shadow-sm bg-white p-3 h-100">
            <h6 class="text-muted mb-2 text-uppercase fw-bold small">Pass Rate (>=50%)</h6>
            <h3 class="fw-bold mb-0 text-success"><%= stats.passRate %>%</h3>
          </div>
        </div>
        <!-- Highest Score -->
        <div class="col-sm-6 col-md-3">
          <div class="card border-0 shadow-sm bg-white p-3 h-100">
            <h6 class="text-muted mb-2 text-uppercase fw-bold small">Highest Score</h6>
            <h3 class="fw-bold mb-0 text-warning-emphasis"><%= stats.highestMark %>%</h3>
          </div>
        </div>
        <!-- Lowest Score -->
        <div class="col-sm-6 col-md-3">
          <div class="card border-0 shadow-sm bg-white p-3 h-100">
            <h6 class="text-muted mb-2 text-uppercase fw-bold small">Lowest Score</h6>
            <h3 class="fw-bold mb-0 text-danger"><%= stats.lowestMark %>%</h3>
          </div>
        </div>
      </div>

      <!-- Report Table -->
      <div class="card border-0 shadow-sm bg-white p-4">
        <% if (records.length === 0) { %>
          <div class="text-muted text-center py-5">
            <i class="fa-solid fa-clipboard-question fa-3x mb-3 text-light"></i>
            <p class="mb-0">No exam marks records found for the selected criteria.</p>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Student Name</th>
                  <th>Class</th>
                  <th>Subject</th>
                  <th>Exam Type</th>
                  <th>Score</th>
                  <th>Percentage</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% records.forEach(rec => { %>
                  <% const pct = Math.round((rec.marksObtained / rec.maxMarks) * 100); %>
                  <tr>
                    <td><span class="fw-bold text-dark"><%= rec.student ? rec.student.name : 'N/A' %></span></td>
                    <td><%= rec.student && rec.student.class ? rec.student.class.name : 'N/A' %></td>
                    <td><span class="fw-semibold text-primary"><%= rec.subjectName %></span></td>
                    <td><%= rec.examType %></td>
                    <td><span class="fw-bold"><%= rec.marksObtained %> / <%= rec.maxMarks %></span></td>
                    <td><%= pct %>%</td>
                    <td>
                      <% if (pct >= 50) { %>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2">Pass</span>
                      <% } else { %>
                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2">Fail</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
