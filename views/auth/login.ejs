<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — Ilmio Madrasa Portal</title>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-page">

  <div class="login-card">
    <div class="login-logo">
      <i class="fa-solid fa-mosque"></i>
    </div>
    <h2 class="login-title">Ilmio</h2>
    <p class="login-sub">Madrasa Management Portal</p>
    
    <% if (error) { %>
      <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center mb-4" role="alert" style="border-radius:10px; font-size:13.5px; font-weight:600;">
        <i class="fa-solid fa-circle-exclamation me-2 fs-5"></i>
        <div><%= error %></div>
      </div>
    <% } %>

    <% if (success) { %>
      <div class="alert alert-success border-0 shadow-sm d-flex align-items-center mb-4" role="alert" style="border-radius:10px; font-size:13.5px; font-weight:600;">
        <i class="fa-solid fa-circle-check me-2 fs-5"></i>
        <div><%= success %></div>
      </div>
    <% } %>

    <form action="/auth/login" method="POST">
      <div class="mb-4">
        <label for="username" class="form-label-modern">Username / Phone Number</label>
        <div class="input-group">
          <span class="input-group-text bg-light border-0 text-muted" style="border-radius:10px 0 0 10px; border:1.5px solid var(--border); border-right:none;"><i class="fa-solid fa-user"></i></span>
          <input type="text" class="form-control form-control-modern" style="border-radius:0 10px 10px 0;" id="username" name="username" placeholder="Enter username or phone" required>
        </div>
      </div>

      <div class="mb-4">
        <label for="password" class="form-label-modern">Password</label>
        <div class="input-group">
          <span class="input-group-text bg-light border-0 text-muted" style="border-radius:10px 0 0 10px; border:1.5px solid var(--border); border-right:none;"><i class="fa-solid fa-lock"></i></span>
          <input type="password" class="form-control form-control-modern" style="border-radius:0 10px 10px 0;" id="password" name="password" placeholder="Enter password" required>
        </div>
      </div>

      <button type="submit" class="btn btn-primary-vivid w-100 py-3 mt-2 mb-4 justify-content-center" style="font-size:15px; border-radius:12px;">
        <i class="fa-solid fa-arrow-right-to-bracket me-2"></i>
        Login to Portal
      </button>
    </form>

    <div class="p-3 rounded shadow-inner" style="background:var(--surface-2); border:1.5px solid var(--border);">
      <h6 class="fw-bold text-dark border-bottom pb-2 mb-2" style="font-size:13px;"><i class="fa-solid fa-key me-2" style="color:var(--indigo);"></i>Demo Accounts:</h6>
      <div class="small text-secondary" style="font-size:12px; line-height:1.6;">
        <div class="mb-1"><strong>Admin:</strong> <code>admin</code> / <code>admin123</code></div>
        <div class="mb-1"><strong>Teacher:</strong> <code>teacher1</code> / <code>teacher123</code></div>
        <div><strong>Parent:</strong> <code>parent1</code> / <code>parent123</code></div>
      </div>
    </div>
  </div>

  <!-- Bootstrap 5 Bundle JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
